[Unit]
Description=Scrap task worker
After=network.target postgresql.service scrap-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/scrap
EnvironmentFile=/opt/scrap/.env
ExecStart=/opt/scrap/.venv/bin/python -m app.workers.runner
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
