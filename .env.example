# Application
APP_NAME=scrap
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8800
APP_SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+psycopg2://scrap:scrap@127.0.0.1:5432/scrap

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=5

# Scraping
HTTP_TIMEOUT_SECONDS=60
HTTP_USER_AGENT=Mozilla/5.0 (compatible; ScrapBot/0.1; +https://scrap.crmflow24.ru)

# CLIProxyAPI (OpenAI-compatible /v1/chat/completions only)
CLIPROXYAPI_BASE_URL=
CLIPROXYAPI_API_KEY=
CLIPROXYAPI_DEFAULT_TIMEOUT=120
CLIPROXYAPI_MAX_RETRIES=2

# Rewrite (mock | cliproxy via LLM layer)
REWRITER_PROVIDER=mock
REWRITE_MODEL_ALIAS=local/rewrite-main
REVIEW_MODEL_ALIAS=local/classifier-fast
SEO_MODEL_ALIAS=local/seo-main

# Feature flags
ENABLE_HERMES=false
ENABLE_HERMES_REASONING=false
ENABLE_HERMES_CAMPAIGNS=false
ENABLE_HERMES_RESEARCH=false
ENABLE_AUTO_PUBLISH=false

# Hermes optional orchestration (HTTP only — not a runtime dependency)
HERMES_BASE_URL=http://127.0.0.1:8000
HERMES_ORCHESTRATE_URL=
HERMES_API_KEY=
HERMES_TIMEOUT=120
HERMES_MAX_RETRIES=1
HERMES_DEFAULT_AGENT=hermes-smart
ENABLE_SEO_ENRICH=true
ENABLE_LLM_REVIEW=true
ENABLE_PROJECT_PROFILES=true

# Content quality review (editorial — manual-first)
ENABLE_QUALITY_REVIEW=true
QUALITY_MODEL_ALIAS=local/qc-reviewer
MIN_QUALITY_SCORE_FOR_PUBLISH=70

# Analytics (manual import)
ENABLE_ANALYTICS=true
ENABLE_PUBLICATION_TRACKING=true

# Media pipeline (optional preview — does not block publish)
ENABLE_MEDIA_PIPELINE=true
ENABLE_MEDIA_GENERATION=false
MEDIA_PROVIDER=placeholder
MEDIA_STORAGE_PATH=/opt/scrap/storage/media

# Editorial workflow (operator approval before publish)
ENABLE_EDITORIAL_WORKFLOW=true

# Source discovery (controlled crawl — manual enqueue only)
ENABLE_SOURCE_DISCOVERY=true
DISCOVERY_DEFAULT_MAX_URLS=50
DISCOVERY_DEFAULT_TIMEOUT=30

# Publish (manual draft only — no auto-publish)
ENABLE_PUBLISHING=true
# When CRMFLOW24_PUBLISH_ENDPOINT is set, crmflow24-draft-webhook target sends real HTTP (draft only)
CRMFLOW24_PUBLISH_ENDPOINT=
CRMFLOW24_PUBLISH_TOKEN=
PUBLISH_DEFAULT_TIMEOUT=60

# Export / integration (legacy)
CRMFLOW24_EXPORT_WEBHOOK_URL=
CRMFLOW24_EXPORT_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_DIR=storage/logs

# System backups (manual scripts — storage/system_backups/)
# Run: bash scripts/backup_postgres.sh && bash scripts/backup_storage.sh
# Scheduler & controlled automation (Stage 4A)
ENABLE_SCHEDULER=false
ENABLE_AUTOMATION=false
SCHEDULER_INTERVAL_SECONDS=60
AUTOMATION_MAX_CONCURRENT_RUNS=1
AUTOMATION_GLOBAL_HOURLY_LIMIT=50
AUTOMATION_RUN_STALE_SECONDS=600
AUTOMATION_RUN_LOCK_SECONDS=1800
# Workspace validation
EXPECTED_HOSTNAME=hermes
EXPECTED_PROJECT_PATH=/opt/scrap

# Mock inbound receiver (testing only)
CRMFLOW24_MOCK_ENDPOINT=http://127.0.0.1:8800/api/mock-crmflow24/articles/import
MOCK_CRMFLOW24_FAIL_MODE=

# Campaign planning (4E) ? operator-controlled, no autonomous planning
ENABLE_CAMPAIGN_PLANNING=true

# CRMFlow24 production import (stage 4F) ? bearer token only in server .env
CRMFLOW24_PUBLISH_ENDPOINT=https://crmflow24.ru/api/scrap/articles/import
CRMFLOW24_PUBLISH_TOKEN=
SCRAP_CRMFLOW24_IMPORT_URL=https://crmflow24.ru/api/scrap/articles/import
SCRAP_CRMFLOW24_IMPORT_TOKEN=

# Topic extraction LLM cleanup & strategy gate (4G)
ENABLE_LLM_TOPIC_CLEANUP=true
TOPIC_CLEANUP_MODEL_ALIAS=local/classifier-fast
MIN_TOPIC_RELEVANCE_FOR_STRATEGY=60

# Async LLM enrichment (4H)
ENABLE_ASYNC_LLM_ENRICHMENT=true
TOPIC_CLEANUP_TIMEOUT_SECONDS=25
SEO_ENRICH_TIMEOUT_SECONDS=60
QUALITY_REVIEW_TIMEOUT_SECONDS=90
ENRICHMENT_MAX_RETRIES=3
ENRICHMENT_STALE_SECONDS=180
ENRICHMENT_MAX_CONCURRENT=2
ENRICHMENT_BATCH_SIZE=3
